# Server
PORT=8080

# Neon PostgreSQL Database
# Option 1: Full Neon connection string (JDBC or postgresql://)
# DB_URL=jdbc:postgresql://ep-cool-fog-123456.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
# Option 2: Separate parameters
DB_URL=jdbc:postgresql://localhost:5432/book_system
DB_USER=admin2003
DB_PASS=admin2003

# JWT Secrets & Expirations (Refresh tokens are securely stored in PostgreSQL DB)
SECRET=uzbekistan_uzbekistan_1234567890
ACCESS_TIME=900000
REFRESH_TIME=604800000
RESET_TIME=900000

# Mail Service (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# CORS & Cookies
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
